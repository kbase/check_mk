#!/usr/bin/env python3

"""
CheckMK local check: StatefulSet readiness and rollout health

Deploy to: /usr/lib/check_mk_agent/local/statefulset_checker
Make executable: chmod +x /usr/lib/check_mk_agent/local/statefulset_checker

Status mapping:
  0 (OK)      - all StatefulSets are fully ready and deployed
  2 (CRIT)    - one or more StatefulSets are missing ready replicas or have an incomplete rollout
  3 (UNKNOWN) - kubectl/parse error
"""

import json
import subprocess
import sys

KUBECTL = ["microk8s", "kubectl"]


def get_statefulsets() -> list[dict]:
    try:
        result = subprocess.run(
            KUBECTL + ["get", "statefulsets", "-A", "-o", "json"],
            capture_output=True,
            text=True,
            timeout=30,
        )
    except FileNotFoundError:
        print("3 K8s_StatefulSets - UNKNOWN: microk8s kubectl not found")
        sys.exit(0)
    except subprocess.TimeoutExpired:
        print("3 K8s_StatefulSets - UNKNOWN: kubectl timed out")
        sys.exit(0)

    if result.returncode != 0:
        stderr = result.stderr.strip().replace("\n", " ")
        print(f"3 K8s_StatefulSets - UNKNOWN: kubectl error - {stderr}")
        sys.exit(0)

    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        print(f"3 K8s_StatefulSets - UNKNOWN: JSON parse error - {exc}")
        sys.exit(0)

    if not isinstance(payload, dict) or not isinstance(payload.get("items"), list):
        print("3 K8s_StatefulSets - UNKNOWN: unexpected kubectl JSON shape")
        sys.exit(0)

    return payload["items"]


def service_name(key: str) -> str:
    return "K8s_StatefulSet_" + key.replace("/", "_").replace("-", "_")


def expected_updated_replicas(statefulset: dict, desired: int) -> int | None:
    strategy = statefulset.get("spec", {}).get("updateStrategy", {}) or {}
    strategy_type = strategy.get("type", "RollingUpdate")

    if strategy_type != "RollingUpdate":
        return None

    partition = strategy.get("rollingUpdate", {}).get("partition", 0) or 0
    return max(desired - partition, 0)


def service_line(statefulset: dict) -> tuple[bool, str]:
    meta = statefulset.get("metadata", {})
    spec = statefulset.get("spec", {})
    status = statefulset.get("status", {})

    namespace = meta.get("namespace", "unknown")
    name = meta.get("name", "unknown")
    key = f"{namespace}/{name}"

    desired = spec.get("replicas", 1) or 0
    replicas = status.get("replicas", 0) or 0
    ready = status.get("readyReplicas", 0) or 0
    updated = status.get("updatedReplicas", 0) or 0
    observed_generation = status.get("observedGeneration", 0) or 0
    generation = meta.get("generation", 0) or 0

    issues = []

    if observed_generation < generation:
        issues.append(f"controller has not observed generation {generation} yet")

    if replicas != desired:
        issues.append(f"replicas {replicas}/{desired}")

    if ready < desired:
        issues.append(f"ready {ready}/{desired}")

    expected_updated = expected_updated_replicas(statefulset, desired)
    if expected_updated is not None and updated < expected_updated:
        issues.append(f"updated {updated}/{expected_updated}")

    perf = f"desired={desired} ready={ready} replicas={replicas} updated={updated}"

    if not issues:
        return True, f"0 {service_name(key)} {perf} OK: {key} - fully ready and deployed"

    return False, f"2 {service_name(key)} {perf} CRIT: {key} - {'; '.join(issues)}"


def main() -> None:
    statefulsets = get_statefulsets()

    if not statefulsets:
        return

    lines = []

    for statefulset in sorted(
        statefulsets,
        key=lambda item: (
            item.get("metadata", {}).get("namespace", ""),
            item.get("metadata", {}).get("name", ""),
        ),
    ):
        _, line = service_line(statefulset)
        lines.append(line)

    for line in lines:
        print(line)


if __name__ == "__main__":
    main()
