#!/usr/bin/env python3
"""
CheckMK local check: Kubernetes failed jobs (BackoffLimitExceeded / DeadlineExceeded)

Deploy to: /usr/lib/check_mk_agent/local/k8s_failed_jobs
Make executable: chmod +x /usr/lib/check_mk_agent/local/k8s_failed_jobs

Emits a single service, K8s_Failed_Jobs, on every run. One service per job would
need a fresh CheckMK discovery before each new failure could alert, and job names
carry a template hash, so discovered services would accumulate forever.

This reads Events, which Kubernetes expires after ~1h by default. A job that
failed before that window is not reported even if its Job object is still in a
Failed state, and a job that keeps retrying will alert, clear, and alert again.

Status mapping:
  0 (OK)      - no job failure events in the cluster's event window
  2 (CRIT)    - one or more jobs have a BackoffLimitExceeded/DeadlineExceeded event
  3 (UNKNOWN) - kubectl/parse error
"""

import json
import subprocess
import sys

KUBECTL = ["microk8s", "kubectl"]
FAILURE_REASONS = {"BackoffLimitExceeded", "DeadlineExceeded"}

# Cap the service detail so a churning controller cannot grow the line without bound.
MAX_LISTED = 10


def get_events() -> list[dict]:
    try:
        result = subprocess.run(
            KUBECTL + ["get", "events", "-A", "-o", "json"],
            capture_output=True,
            text=True,
            timeout=30,
        )
    except OSError as exc:
        print(f"3 K8s_Failed_Jobs - UNKNOWN: failed to execute kubectl - {exc}")
        sys.exit(0)
    except subprocess.TimeoutExpired:
        print("3 K8s_Failed_Jobs - UNKNOWN: kubectl timed out")
        sys.exit(0)

    if result.returncode != 0:
        stderr = result.stderr.strip().replace("\n", " ")
        print(f"3 K8s_Failed_Jobs - UNKNOWN: kubectl error - {stderr}")
        sys.exit(0)

    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        print(f"3 K8s_Failed_Jobs - UNKNOWN: JSON parse error - {exc}")
        sys.exit(0)

    if not isinstance(payload, dict) or not isinstance(payload.get("items"), list):
        print("3 K8s_Failed_Jobs - UNKNOWN: unexpected kubectl JSON shape")
        sys.exit(0)

    return payload["items"]


def clean(text: str) -> str:
    # '|' separates perfdata from plugin output in CheckMK, so keep it out of the detail.
    return text.replace("\n", " ").replace("|", "/").strip()


def collect_failures(events: list[dict]) -> dict[str, dict]:
    """
    Returns a dict keyed by "namespace/job-name", holding the failure reason,
    the summed event count and the most recent message for that job.
    """
    failures: dict[str, dict] = {}

    for event in events:
        if not isinstance(event, dict):
            continue

        obj = event.get("involvedObject") or {}
        reason = event.get("reason", "")

        if obj.get("kind") != "Job" or reason not in FAILURE_REASONS:
            continue

        namespace = (event.get("metadata") or {}).get("namespace", "unknown")
        job_name = obj.get("name", "unknown")
        key = f"{namespace}/{job_name}"

        info = failures.setdefault(key, {"reason": "", "count": 0, "message": ""})
        info["reason"] = reason
        info["count"] += event.get("count") or 1
        info["message"] = clean(event.get("message") or "")

    return failures


def main() -> None:
    failures = collect_failures(get_events())

    job_count = len(failures)
    event_count = sum(info["count"] for info in failures.values())
    # Emitted on both branches so the metric stays graphable across state changes.
    perf = f"failed_jobs={job_count}|events={event_count}"

    if not failures:
        print(f"0 K8s_Failed_Jobs {perf} OK: no failed jobs found")
        return

    details = [
        f"{key} - {info['reason']} (events: {info['count']}) - "
        f"{info['message'] or 'no details'}"
        for key, info in sorted(failures.items())
    ]

    listed = details[:MAX_LISTED]
    if len(details) > MAX_LISTED:
        listed.append(f"... and {len(details) - MAX_LISTED} more")

    print(
        f"2 K8s_Failed_Jobs {perf} CRIT: {job_count} job(s) failed, "
        f"{event_count} failure event(s): " + " :: ".join(listed)
    )


if __name__ == "__main__":
    main()
